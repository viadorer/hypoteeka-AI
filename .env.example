# ===========================================
# Hypoteeka AI - Environment Variables
# ===========================================
# Zkopíruj tento soubor jako .env.local a doplň hodnoty:
#   cp .env.example .env.local

# ------------------------------------------
# Tenant (slug z tabulky tenants)
# ------------------------------------------
NEXT_PUBLIC_TENANT_ID=hypoteeka

# ------------------------------------------
# AI API Keys (per tenant)
# ------------------------------------------
# Hlavní klíč (fallback pro všechny tenanty)
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key-here

# Tenant-specific klíče (volitelné - pokud chcete oddělený billing)
# GOOGLE_AI_KEY_HYPOTEEKA=your-hypoteeka-api-key
# GOOGLE_AI_KEY_ODHAD=your-odhad-api-key

# ------------------------------------------
# Supabase = SDÍLENÝ PROJEKT PTF REALITY (viz db/ptf-setup/README.md)
# Tabulky hypoteeky žijí ve schématu "hypoteeka", PTF public se nemění.
# Povinné pro Vercel (produkce bez DB tvrdě selže); lokální dev bez nich
# použije JsonFileStorage.
# ------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-ptf-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-ptf-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-ptf-service-role-key

# ------------------------------------------
# PTF reality backend (Railway) — předávání leadů do CRM
# Bez PTF_API_URL se předání tiše přeskočí (lead zůstává lokálně)
# ------------------------------------------
PTF_API_URL=https://ptf-production.up.railway.app
# Leady jdou pod tenantem ptf-reality (admin PTF nemá přepínač tenantů),
# rozlišené přes metadata.origin='hypoteeka'
PTF_TENANT_SLUG=ptf-reality

# ------------------------------------------
# Brevo (email)
# ------------------------------------------
BREVO_API_KEY=your-brevo-api-key

# ------------------------------------------
# ČNB ARAD API
# ------------------------------------------
CNB_ARAD_API_KEY=202611020853228993488993483ZHG4W4URZKDGU37
